# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# --- Frontend (Vite) ---
# Base URL of the local write-back backend (server/). Only used for the
# CS Master lat/lng correction feature. Safe to expose — it's just a URL.
VITE_CS_MASTER_API_URL=http://localhost:8787

# --- Backend (server/, Node-only — never exposed to the browser bundle) ---
# Paste the ENTIRE contents of the downloaded Google Cloud Service Account
# JSON key file here as a single-line string. The service account's email
# must be shared as an Editor on the CS Master spreadsheet.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Drive folder that all uploaded documents are filed under. Create the folder
# yourself, share it with the Service Account email as an Editor, then paste
# the folder ID from its URL (…/folders/<THIS PART>).
# Leave blank to run uploads in mock mode (no file actually leaves the browser).
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Port the write-back backend listens on.
SERVER_PORT=8787
