# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# --- Backend (server/ locally, api/ on Vercel — Node-only, never exposed to
# the browser bundle). The frontend always calls relative /api/... paths: in
# dev those are proxied to the local server (see vite.config.ts), and on
# Vercel they're served by the api/ serverless functions directly — so these
# only need to be set once, either in .env for local dev or as Vercel
# project environment variables for production. ---

# Paste the ENTIRE contents of the downloaded Google Cloud Service Account
# JSON key file here as a single-line string. The service account's email
# must be shared as an Editor on the main spreadsheet.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Drive folder that all uploaded documents are filed under. Create the folder
# yourself, share it with the Service Account email as an Editor, then paste
# the folder ID from its URL (…/folders/<THIS PART>).
# Leave blank to run uploads in mock mode (no file actually leaves the browser).
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Port the local write-back backend listens on (npm run server). Not used on
# Vercel — serverless functions don't listen on a port.
SERVER_PORT=8787

# Signs/verifies login session tokens (server/session.ts). Required in
# production — without it, sessions fall back to an insecure, publicly-known
# default secret and must never be relied on for real logins. Generate a
# value with:
#   openssl rand -base64 32
AUTH_SESSION_SECRET=

# --- Optional: only relevant if/when a scheduled cron is added for
# handleSyncUniiOrders (server/lib.ts). The sync itself is manually
# triggered from the Settings page today, with no cron wired up — see that
# section's header comment for why. The Unii API key itself is NOT an env
# var; it's admin-set on the Settings page and stored in the "App Settings"
# Sheets tab. ---

# Lets a Vercel Cron (or any scheduled caller) trigger a sync without a real
# user session — Vercel auto-attaches this as "Authorization: Bearer
# $CRON_SECRET" to cron-invoked requests when set in vercel.json. Leave
# blank if you're not using a cron; the Settings page button doesn't need it.
CRON_SECRET=

# Wall-clock budget (ms) one sync run spends paginating before it stops and
# persists a resume point for the next run — default 45000 if unset. Raise
# this only as far as your route's actual maxDuration allows, leaving
# headroom for the final Sheets write after the fetch loop ends.
UNII_SYNC_BUDGET_MS=
